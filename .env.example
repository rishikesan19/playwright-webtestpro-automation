# Copy to .env (or .env.<TEST_ENV>) and adjust. Real environment variables always take precedence.
# Never commit .env files - they are git-ignored.

# Selects an optional .env.<TEST_ENV> override file (default: production)
TEST_ENV=production

# Application under test
BASE_URL=https://automationexercise.com
API_BASE_URL=https://automationexercise.com/api

# Optional fixed password for generated test users. Leave empty to generate a random one per user.
TEST_USER_PASSWORD=

# Maximum acceptable API response time in milliseconds
API_RESPONSE_TIME_LIMIT_MS=3000

# Abort requests to ad / consent-management hosts that overlay and intercept clicks on the site
BLOCK_THIRD_PARTY_ADS=true

# debug | info | warn | error
LOG_LEVEL=info

# Optional execution overrides (defaults: retries 2 on CI / 1 locally, workers 2 on CI / 4 locally)
WORKERS=
RETRIES=
